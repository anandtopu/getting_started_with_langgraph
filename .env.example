# Live provider; offline examples and graded tasks ignore provider settings.
LLM_PROVIDER=ollama
# Optional model override. Leave empty to use the selected provider default below.
LLM_MODEL=
# Verified local tool-calling model; download once with Ollama.
OLLAMA_MODEL=qwen3:4b
# Ollama service URL. No hosted API key is needed.
OLLAMA_BASE_URL=http://localhost:11434
# Verified optional hosted model defaults (2026-11-05); account access is separate.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-haiku-5-5
GOOGLE_MODEL=gemini-3.5-flash-lite
# Optional hosted keys; never commit populated values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Maximum response size for optional live walkthroughs.
LLM_MAX_TOKENS=512
# Local connection timeout, in seconds, for optional service checks.
LLM_TIMEOUT_SECONDS=10
# Synthetic production demonstrations only; configured in later deployment modules.
DATABASE_URL=
# Optional checkpoint encryption key. Leave empty until the security lesson.
LANGGRAPH_AES_KEY=
# Remote tracing is opt-in and always disabled in graded work.
LANGSMITH_TRACING=false
# Optional tracing credentials and project name; never print the key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=larkspur-course
# Local API credentials: use distinct random strings of at least 16 characters.
LARKSPUR_CUSTOMER_TOKEN=
LARKSPUR_ADJUSTER_TOKEN=
# The demo identity provider scopes both local roles to this synthetic customer.
LARKSPUR_CUSTOMER_ID=CUS-0001
# Local SQLite state directory when DATABASE_URL is unset.
LARKSPUR_STATE_DIR=workspace/server
# Dashboard-to-API URL; Compose overrides this inside its private network.
LARKSPUR_API_URL=http://127.0.0.1:8000
# Compose database credential; prefer a random URL-safe value.
LARKSPUR_DB_PASSWORD=
