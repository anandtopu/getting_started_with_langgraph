	__start__ -.-> policy;
	communication -.-> __end__;
	communication -.-> fraud;
	communication -.-> intake;
	communication -.-> policy;
	fraud -.-> __end__;
	fraud -.-> communication;
	fraud -.-> intake;
	fraud -.-> policy;
	intake -.-> __end__;
	intake -.-> communication;
	intake -.-> fraud;
	intake -.-> policy;
	policy -.-> __end__;
	policy -.-> communication;
	policy -.-> fraud;
	policy -.-> intake;
	communication -.-> communication;
	fraud -.-> fraud;
	intake -.-> intake;
	policy -.-> policy;
	classDef default fill:#f2f0ff,line-height:1.2
