"""Start task futures before resolving them; compare with a Send graph. No LLM.

Run: uv run python modules/15_functional_api/examples/02_parallel_futures.py
Expected: both APIs return the same canonically ordered document findings.
"""

import operator
from typing import Annotated, TypedDict

from langgraph.func import entrypoint, task
from langgraph.graph import END, START, StateGraph
from langgraph.types import Send

from common.pretty import print_state

DEFAULT_CASE = {"documents": ["estimate", "receipt", "police_report"]}


def finding(document: str) -> str:
    return document + (":review" if document == "police_report" else ":ready")


@task
def inspect_document(document: str) -> str:
    return finding(document)


@entrypoint()
def functional(documents: list[str]) -> list[str]:
    futures = [inspect_document(document) for document in documents]
    return sorted(future.result() for future in futures)


class State(TypedDict):
    documents: list[str]
    findings: Annotated[list[str], operator.add]


class Worker(TypedDict):
    document: str


def build_graph():
    graph = StateGraph(State)
    graph.add_node("inspect_document", lambda state: {"findings": [finding(state["document"])]}, input_schema=Worker)
    graph.add_conditional_edges(START, lambda state: [Send("inspect_document", {"document": document}) for document in state["documents"]] or [END], ["inspect_document", END])
    graph.add_edge("inspect_document", END)
    return graph.compile()


def run(case: dict | None = None) -> dict:
    case = DEFAULT_CASE if case is None else case
    first = functional.invoke(case["documents"], version="v2").value
    second = build_graph().invoke({"documents": case["documents"], "findings": []}, version="v2").value
    return {"functional": first, "graph": sorted(second["findings"]), "equal": first == sorted(second["findings"])}


def main() -> None:
    print_state(run())


if __name__ == "__main__":
    main()
