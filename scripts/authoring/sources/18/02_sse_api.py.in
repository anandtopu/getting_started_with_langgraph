"""Exercise real authenticated SSE routes with in-process HTTP. Requires apps extra.

Run: uv run --extra apps python modules/18_streaming_user_interfaces/examples/02_sse_api.py
Expected: customer approval is forbidden, stale approval conflicts, and one approved effect.
"""

from common.app_demo import run_demo
from common.pretty import print_state
from common.sse import decode_events, encode_event

DEFAULT_CASE = {"approved": True, "stale": True, "note": "Estimate\nreceived"}


def run(case: dict | None = None) -> dict:
    case = DEFAULT_CASE if case is None else case
    frame = encode_event("progress", {"node": case["note"]}, 1)
    decoded = decode_events(frame)
    result = run_demo(approve=case["approved"], stale=case["stale"])
    return {**result, "framing_roundtrip": decoded[0]["data"]["node"] == case["note"], "frame_count": len(decoded)}


def main() -> None:
    print_state(run())


if __name__ == "__main__":
    main()
